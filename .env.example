# ===== Copy this file to ".env" and fill in real values. NEVER commit ".env". =====
# On Render you type these into the dashboard instead (Environment tab).

# --- General ---
TZ=Asia/Manila
PORT=3000
# true = temporary in-memory database (testing only). Leave false for real use.
USE_MEMORY_DB=false

# --- PSE Edge (public pages, no key) ---
PSE_BASE_URL=https://edge.pse.com.ph
PSE_USER_AGENT=PersonalStockTracker/1.0 (personal use; contact: you@example.com)
PSE_REQUEST_TIMEOUT_MS=15000
PSE_DELAY_BETWEEN_STOCKS_MS=1500

# --- Collection / schedule (Asia/Manila, 24h) ---
COLLECTION_INTERVAL_SECONDS=60
TRADING_WINDOW_START=09:25
TRADING_WINDOW_END=15:05
# PSE market close (pre-close 2:45, run-off 2:50, close 3:00 PM)
MARKET_CLOSE_TIME=15:00
OHLC_TIME=15:10
HISTORY_REFRESH_DAYS=45
PSEI_EVERY_MINUTES=10
RETENTION_DAYS=400

# --- Report ---
REPORT_TIME=15:00
REPORT_CATCHUP_WINDOW_MINUTES=180
REPORT_MAX_ATTEMPTS=5
# Candlestick period: 31=1 month, 93=3 months, 186=6 months, 365=1 year
CHART_PERIOD_DAYS=31

# --- Firebase / Firestore ---
# EASIEST: put the whole downloaded JSON key as one base64 line (see docs/TROUBLESHOOTING.md), then leave the 3 lines below empty.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the quotes and the \n characters exactly as in the downloaded JSON key.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Stock Tracker <onboarding@resend.dev>
EMAIL_TO=you@example.com
# SAFE DEFAULT. true = build a preview file only, send NOTHING.
# Set to false only when you are ready for real emails.
EMAIL_TEST_MODE=true

# --- Security ---
# Long random string. cron-job.org must send it (header "x-cron-key" is best; ?key= also works).
CRON_SECRET=change-me-to-a-long-random-string
